NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets (share the sheet with the service account email)
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_RANGE=Sheet1!A:J

# Notify email (Resend OR SMTP)
NOTIFY_EMAIL=you@example.com

# Option A: Resend
RESEND_API_KEY=
RESEND_FROM=Leads <onboarding@resend.dev>

# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

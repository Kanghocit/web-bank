SITE_URL=https://vp-bank.vercel.app

# Required on Vercel: same Apps Script URL as local .env
GOOGLE_SHEETS_WEBAPP_URL=

# Optional: service account instead of Apps Script
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_RANGE=Leads!A:H

NOTIFY_EMAIL=you@example.com

RESEND_API_KEY=
RESEND_FROM=Leads <onboarding@resend.dev>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
